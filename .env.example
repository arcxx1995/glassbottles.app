# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (transactional email) ───────────────────────────
# Required by supabase/functions/notify-receiver
# Must also be set as a Supabase secret: supabase secrets set RESEND_API_KEY=<key>
RESEND_API_KEY=
# Optional — defaults to "glassbottles <hello@glassbottles.app>"
RESEND_FROM_ADDRESS=glassbottles <hello@glassbottles.app>

# ─── Anthropic (safety screen) ──────────────────────────────
# Used by supabase/functions/screen-bottle and spark (Claude Haiku). Supabase secret only:
#   supabase secrets set ANTHROPIC_API_KEY=<key>
# Unset = only the built-in contact-details check runs (everything else sails),
# and sparks come from the app's static deck.
ANTHROPIC_API_KEY=

# ─── Web Push (VAPID) ───────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Public key → Vercel env (client). Both keys → Supabase secrets (push-notify):
#   supabase secrets set VAPID_PUBLIC_KEY=<pub> VAPID_PRIVATE_KEY=<priv> VAPID_SUBJECT=mailto:hello@glassbottles.app
# Unset = no push UI anywhere; email + in-app banners still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Google OAuth (Supabase Auth external provider) ─────────
# Created in Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (type: Web application). See SETUP below / AGENT_LOG_SHIV.md.
# Consumed by supabase/config.toml via env() substitution ([auth.external.google]).
# For local dev these live here; for hosted they go in the Supabase dashboard
# (Auth → Providers → Google) and in Vercel env vars (all environments).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ─── Dodo Payments (Keeper membership) ──────────────────────
# Dashboard → Developer → API keys / Webhooks. Webhook URL:
#   https://<host>/api/webhooks/dodo  (events: subscription.*, payment.succeeded, refund.succeeded)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ids: Keeper monthly ($2.99), yearly ($24), Founding Keeper lifetime ($49, one-time)
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_PRODUCT_LIFETIME=
# Shows the Keeper card + copy. Leave off until the first perk ships.
NEXT_PUBLIC_KEEPER=off

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://test.glassbottles.app
NEXT_PUBLIC_APP_ENV=production

# ─── Vercel (CI/CD deploy scripts) ──────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
