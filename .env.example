# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── WhatsApp (Meta Cloud API) ──────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=glassbottle_received

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://glassbottles.app
NEXT_PUBLIC_APP_ENV=production

# ─── Feature Flags ───────────────────────────────────────────
# Set to 'true' to enable WhatsApp OTP verification before marking
# whatsapp_verified=true. Requires migration 009+010 and a WhatsApp
# OTP message template. Leave unset (or 'false') for v1 immediate-verify.
WHATSAPP_OTP_ENABLED=false

# ─── Vercel (CI/CD deploy scripts) ──────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
